{
    "name": "savegame-editor",
    "private": true,
    "version": "1.0.9",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "lint": "bun run lint:frontend && bun run lint:rust",
        "lint:frontend": "tsc --noEmit && eslint --no-error-on-unmatched-pattern src vite.config.ts \"tests/**/*.{ts,tsx}\"",
        "lint:rust": "cd src-tauri && cargo clippy --all-targets",
        "format": "bun run format:frontend && bun run format:rust",
        "format:frontend": "prettier --write --no-error-on-unmatched-pattern src vite.config.ts eslint.config.mjs .prettierrc.json \"tests/**/*.{ts,tsx}\"",
        "format:rust": "cd src-tauri && cargo fmt --all",
        "format:check": "prettier --check --no-error-on-unmatched-pattern src vite.config.ts eslint.config.mjs .prettierrc.json \"tests/**/*.{ts,tsx}\" && cd src-tauri && cargo fmt --all -- --check",
        "tauri": "tauri"
    },
    "dependencies": {
        "@hookform/resolvers": "^7.0.7",
        "@radix-ui/react-avatar": "^1.3.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-hover-card": "^1.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-popover": "^1.3.1",
        "@radix-ui/react-progress": "^1.2.1",
        "@radix-ui/react-separator": "^1.2.0",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-tabs": "^1.2.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@tailwindcss/vite": "^4.3.5",
        "@tanstack/react-query": "^5.108.0",
        "@tanstack/react-table": "^9.3.1",
        "@tauri-apps/api": "^2.12.5",
        "@tauri-apps/plugin-dialog": "^2.8.4",
        "@tauri-apps/plugin-fs": "^2.7.1",
        "@tauri-apps/plugin-opener": "^2.7.3",
        "@tauri-apps/plugin-store": "^2.5.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "embla-carousel-react": "^8.6.0",
        "lucide-react": "^1.76.0",
        "next-themes": "^0.4.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.92.0",
        "react-router-dom": "^7.18.6",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.5",
        "use-debounce": "^10.1.1",
        "vaul": "^1.1.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@babel/core": "^8",
        "@babel/eslint-parser": "^8",
        "@babel/plugin-syntax-jsx": "^8",
        "@babel/preset-typescript": "^8",
        "@eslint/js": "^10",
        "@tauri-apps/cli": "^2.12.6",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "eslint": "^10",
        "eslint-plugin-jsx-a11y": "^6",
        "eslint-plugin-react": "^7",
        "eslint-plugin-react-hooks": "^7",
        "prettier": "^3",
        "tw-animate-css": "^1.4.0",
        "typescript": "~7.0.2",
        "vite": "^8.3.8"
    }
}
